{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sentinelqa/params-env",
  "title": "SentinelQA per-env params (docs/architecture/iac/params/<env>.json)",
  "description": "Sources: ci-and-data-guards.md §1.2 stage 2 (Throttle 10/20, us-east-1), delivery-strategy.md §2a (no secrets, OIDC only), ADR-0013 (lean/strict), ADR-0015 (origin secret never in params), the template Parameters.",
  "definitions": {
    "accountId": { "type": "string", "pattern": "^[0-9]{12}$" },
    "pipelineKey": { "type": "string", "pattern": "^PIPELINE_SUPPLIED:<commit-sha>/[a-z0-9-]+\\.zip$" },
    "note": { "type": "string" }
  },
  "type": "object",
  "required": ["all", "00-bootstrap", "30-api", "40-web", "_meta"],
  "propertyNames": { "pattern": "^(_[A-Za-z_]+|all|00-bootstrap|10-security|20-data|25-backup|30-api|40-web|50-observability)$" },
  "patternProperties": { "^_(?!meta$)[A-Za-z_]+$": { "$ref": "#/definitions/note" } },
  "properties": {
    "all": {
      "type": "object", "additionalProperties": false, "required": ["EnvName", "EnvProfile"],
      "properties": { "EnvName": { "enum": ["dev", "stage", "prod"] }, "EnvProfile": { "enum": ["lean", "strict"] } }
    },
    "00-bootstrap": {
      "type": "object", "additionalProperties": false, "required": ["GitHubRepo", "OidcProviderArn"],
      "properties": {
        "GitHubRepo": { "const": "vishwasvr/SentinelQA" },
        "OidcProviderArn": { "type": "string", "pattern": "^arn:aws:iam::[0-9]{12}:oidc-provider/token\\.actions\\.githubusercontent\\.com$" }
      }
    },
    "10-security": {
      "description": "AlarmEmail is forbidden here: the deploy job passes it from the per-environment GitHub variable vars.ALARM_EMAIL. No other 10-security params are file-supplied.",
      "type": "object", "additionalProperties": false, "properties": {}
    },
    "25-backup": {
      "type": "object", "additionalProperties": false, "required": ["ExportFnKey", "RetentionDays"],
      "properties": { "ExportFnKey": { "$ref": "#/definitions/pipelineKey" }, "RetentionDays": { "const": 2557 } }
    },
    "30-api": {
      "type": "object", "additionalProperties": false,
      "required": ["RecordsApiKey", "ReportsApiKey", "ThrottleRate", "ThrottleBurst"],
      "properties": {
        "RecordsApiKey": { "$ref": "#/definitions/pipelineKey" },
        "ReportsApiKey": { "$ref": "#/definitions/pipelineKey" },
        "ThrottleRate": { "const": 10 },
        "ThrottleBurst": { "const": 20 }
      }
    },
    "40-web": {
      "type": "object", "additionalProperties": false,
      "properties": { "WebACLArn": { "type": "string", "pattern": "^(|arn:aws:wafv2:us-east-1:[0-9]{12}:global/webacl/.+)$" } }
    },
    "_meta": {
      "type": "object", "required": ["AwsAccountId", "AwsRegion", "GitHubEnvironment"],
      "properties": {
        "AwsAccountId": { "$ref": "#/definitions/accountId" },
        "AwsRegion": { "const": "us-east-1" },
        "GitHubEnvironment": { "enum": ["dev", "stage", "prod"] }
      },
      "patternProperties": { "^_": { "$ref": "#/definitions/note" } },
      "additionalProperties": false
    }
  }
}
